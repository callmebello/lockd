{
  "manifest_version": 3,
  "name": "Lockd",
  "description": "Keeps API keys out of the page and out of your AI agent's view: masks keys on screen, saves them to Lockd, types them into forms for you.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["nativeMessaging", "storage", "tabs", "alarms"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://*/*"], "js": ["detect.js", "content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "action": { "default_title": "Lockd", "default_popup": "popup.html" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
